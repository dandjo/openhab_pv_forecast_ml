# pv_forecast_ml's settings, read by the systemd units as their EnvironmentFile (NAME=value, no spaces around =)
# the modules' planes, each name:azimuth:tilt:modules (azimuth from south, east negative), comma-separated
PV_FORECAST_ML_PLANES=e:-90:25:8,w:90:25:8,n:180:25:6
# the inverter's strings, each measured power item:forecast power item:planes joined by +, comma-separated
PV_FORECAST_ML_STRINGS=huawei_inverter_pv1_power:pv_forecast_pv1_power:e,huawei_inverter_pv2_power:pv_forecast_pv2_power:w+n
# optional: the planes whose power optimizers report their power, each plane:measured power item:forecast power item,
# comma-separated; their string's forecast is then split among them (all planes of that string, see the README)
PV_FORECAST_ML_PLANE_ITEMS=w:huawei_optimizers_west_power:pv_forecast_west_power,n:huawei_optimizers_north_power:pv_forecast_north_power
# optional: the items of the band around the house's forecast, low item:high item, optionally :width item (high minus
# low, for a chart that stacks it on the low bound); the band is in pv_forecast_hourly with or without them
PV_FORECAST_ML_BAND_ITEMS=pv_forecast_power_low:pv_forecast_power_high:pv_forecast_power_band
# the location, rounded to 2 decimals; without it openHAB's regional settings
#PV_FORECAST_ML_LATITUDE=
#PV_FORECAST_ML_LONGITUDE=
# the time zone of the days; without it the system's
#PV_FORECAST_ML_TIMEZONE=Europe/Berlin
# openHAB
PV_FORECAST_ML_OPENHAB_URL=http://127.0.0.1:8080
#PV_FORECAST_ML_OPENHAB_TOKEN_FILE=~/.openhab_token
#PV_FORECAST_ML_PERSISTENCE=influxdb
#PV_FORECAST_ML_NOTIFY_RULE=notify_broadcast
# the rest have defaults, see the README
